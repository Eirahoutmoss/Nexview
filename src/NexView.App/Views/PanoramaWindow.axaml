<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:NexView.UI.Controls"
        xmlns:l="using:NexView.UI.Localization"
        x:Class="NexView.App.Views.PanoramaWindow"
        Title="NexView 360°"
        Icon="/Assets/nexview.ico"
        Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NvBgBrush}">
  <Grid RowDefinitions="*,Auto">
    <c:PanoramaViewer x:Name="Viewer" />
    <TextBlock x:Name="Status" Text="{l:T 'Yükleniyor…'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border Grid.Row="1" Background="{StaticResource NvPanelBrush}" BorderBrush="{StaticResource NvBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock x:Name="Info" Classes="label" />
          <TextBlock Text="{l:T 'Sürükleyerek bakın · tekerlekle yakınlaştırın · çift tıkla sıfırlayın'}" Classes="label" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ToggleButton x:Name="Spin" Content="{l:T 'Otomatik dön'}" Padding="12,5" FontSize="12" />
          <Button Classes="ghost" x:Name="ResetBtn" Content="{l:T 'Sıfırla'}" FontSize="12" Padding="12,5" />
          <Button Classes="ghost" x:Name="FullBtn" Content="{l:T 'Tam ekran (F11)'}" FontSize="12" Padding="12,5" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

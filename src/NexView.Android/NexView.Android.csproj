<Project Sdk="Microsoft.NET.Sdk">
  <!-- tools/setup-android.ps1 tarafından üretilir: SDK ve JDK yolları -->
  <Import Project="..\..\android-paths.props" Condition="Exists('..\..\android-paths.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RootNamespace>NexView.Droid</RootNamespace>
    <AssemblyName>NexView.Android</AssemblyName>
    <ApplicationId>com.hasanguler.nexview</ApplicationId>
    <ApplicationTitle>NexView</ApplicationTitle>
    <ApplicationVersion>7</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);XA4211;XA1006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.*" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexView.Core\NexView.Core.csproj" />
    <ProjectReference Include="..\NexView.UI\NexView.UI.csproj" />
    <ProjectReference Include="..\NexView.Mobile\NexView.Mobile.csproj" />
  </ItemGroup>
</Project>
